# Imagen de producción del web: build estático de Vite servido por nginx.
# VITE_API_URL se inyecta en tiempo de build (--build-arg VITE_API_URL=...).
# Para Cloudflare Pages / Vercel / Netlify no hace falta este Dockerfile: usa
# build command "npm run build" y publica el directorio "dist".
FROM node:20-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Fallback SPA: cualquier ruta cae a index.html (react-router).
RUN printf 'server {\n  listen 80;\n  location / {\n    root /usr/share/nginx/html;\n    try_files $uri /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
